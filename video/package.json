{
  "name": "bullxi-film",
  "private": true,
  "version": "1.0.0",
  "description": "BULL-XI demo film (Remotion)",
  "scripts": {
    "clips": "node scripts/record-clips.cjs",
    "voice": "node scripts/voiceover.mjs && node scripts/timeline.mjs",
    "music": "python3 scripts/music.py",
    "studio": "remotion studio",
    "render": "remotion render BullXI out/bullxi-film-raw.mp4 --crf=17 && ffmpeg -y -i out/bullxi-film-raw.mp4 -c:v copy -af loudnorm=I=-14:TP=-1.5:LRA=11 -c:a aac -b:a 192k out/bullxi-film.mp4"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@remotion/cli": "^4.0.547",
    "@remotion/media-utils": "^4.0.547",
    "@types/react": "^19.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.547",
    "typescript": "^7.0.2"
  }
}
