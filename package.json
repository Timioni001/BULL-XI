{
  "name": "bull-xi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "deploy:web": "next build && wrangler deploy",
    "deploy:worker": "wrangler deploy --config worker/wrangler.jsonc",
    "onchain:build": "cd onchain && cargo build-sbf --arch v0",
    "onchain:test": "cd onchain && cargo test",
    "onchain:setup": "tsx scripts/onchain/setup-price-book.ts",
    "onchain:read": "tsx scripts/onchain/read-price-book.ts",
    "onchain:gen": "tsx scripts/onchain/gen-universe.ts",
    "onchain:client": "tsx scripts/onchain/gen-client.mts",
    "onchain:crank": "tsx scripts/onchain/crank.ts",
    "onchain:schedule": "tsx scripts/onchain/schedule.ts"
  },
